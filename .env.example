APP_NAME=ReconFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reconflow
DB_USERNAME=reconflow
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="reconflow@example.com"
MAIL_FROM_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
RECONFLOW_DISPLAY_TIMEZONE=Africa/Nairobi

PII_HASH_SALT=
DEMO_PASSWORD=
SEED_DEMO_USERS=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=300

RETENTION_TRANSACTIONS_YEARS=7
RETENTION_AI_LOGS_MONTHS=12
RETENTION_AUDIT_YEARS=7
AUDIT_ARCHIVE_PATH=
AUDIT_ARCHIVE_CRON="30 2 * * *"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_ENABLED=true

INERTIA_SSR_ENABLED=false

SOURCE_SYSTEMS_DRIVER=local
SOURCE_SYSTEMS_URL=http://127.0.0.1:8000
SOURCE_SYSTEMS_TOKEN=
PAYMENTS_WINDOW_GRACE_HOURS=6
UPLOAD_MAX_KILOBYTES=10240
UPLOAD_MAX_ROWS=50000
UPLOAD_STAGING_TTL_HOURS=24
DEMO_AUTO_SEED=true
DEMO_DAYS=14
DEMO_SALES_PER_DAY=3000
DEMO_SEED=42
