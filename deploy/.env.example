DOMAIN=reconflow.example.com
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_PORT_SUFFIX=
APP_IMAGE=ghcr.io/your-org/reconflow:latest

APP_KEY=
POSTGRES_PASSWORD=
PII_HASH_SALT=
DEMO_PASSWORD=
SEED_DEMO_USERS=true

LOG_LEVEL=info
SESSION_LIFETIME=30
TRUSTED_PROXIES=172.16.0.0/12

RETENTION_TRANSACTIONS_YEARS=7
RETENTION_AI_LOGS_MONTHS=12
RETENTION_AUDIT_YEARS=7

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_ENABLED=true
